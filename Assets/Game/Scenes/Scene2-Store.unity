  m_Script: {fileID: 11500000, guid: 1cfec0f8789e44c458de48709842b015, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoreControl
  visits:
  - nextLevelScene: Scene3-Plant
    message: 'You can buy seeds using your farming fund. Choose how many you want.

      Next level: harvest 5 sunflowers before winter comes.'
    seedsNeeded:
    - crop: {fileID: 11400000, guid: 5b37a65433264874388f6fd4c077e82d, type: 2}
      count: 5
    needsBag: 0
  - nextLevelScene: Scene4-Harvest
    message: 'Sell your harvest, then shop for the next level (new: pumpkins and Speed Boots).

      Next level: harvest 3 pumpkins and 3 sunflowers before winter.'
    seedsNeeded:
    - crop: {fileID: 11400000, guid: bffe4049ca0da0145b1212957afe7e66, type: 2}
      count: 3
    - crop: {fileID: 11400000, guid: 5b37a65433264874388f6fd4c077e82d, type: 2}
      count: 3
    needsBag: 0
  - nextLevelScene: Scene5-InventoryMerge
    message: 'Sell your harvest and buy the bag (new): it keeps your tools, seeds and harvest.

      Next level: harvest 4 pumpkins and 4 sunflowers before winter.'
    seedsNeeded:
    - crop: {fileID: 11400000, guid: bffe4049ca0da0145b1212957afe7e66, type: 2}
      count: 4
    - crop: {fileID: 11400000, guid: 5b37a65433264874388f6fd4c077e82d, type: 2}
      count: 4
    needsBag: 1
  - nextLevelScene: Scene6-FarmLevel5
    message: 'Sell your harvest. Your bag keeps everything you buy.

      Buy pumpkin seeds for the next level.'
    seedsNeeded:
    - crop: {fileID: 11400000, guid: bffe4049ca0da0145b1212957afe7e66, type: 2}
      count: 3
    needsBag: 0
